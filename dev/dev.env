LIVEKIT_API_SECRET=cubie-dev-secret-0123456789abcdef

# Invite-only auth, with messages written to a local outbox instead of Resend.
CUBIE_PUBLIC_URL=http://127.0.0.1:5173
CUBIE_MAIL_DIR=dev/data/mail
CUBIE_BOOTSTRAP_EMAIL=admin@example.test
LIVEKIT_API_URL=http://127.0.0.1:7880
