[Unit]
Description=Cubie LiveKit SFU
After=network-online.target
Wants=network-online.target

[Service]
User=cubie
Group=cubie
EnvironmentFile=/opt/cubie/secrets.env
ExecStart=/opt/cubie/bin/livekit-server --config /opt/cubie/livekit.yaml
Restart=on-failure
RestartSec=2
LimitNOFILE=65536
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
