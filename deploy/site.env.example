# Copy to deploy/site.env.local or export these settings in your shell.
CUBIE_HOST=root@call.example.com
CUBIE_PUBLIC_URL=https://call.example.com
CUBIE_ACME_EMAIL=admin@example.com

# Optional reserve edge for the same service. Set all three together.
# CUBIE_RESERVE_URL=https://backup.example.net
# CUBIE_RESERVE_PROXY_IP=192.0.2.10
# CUBIE_RESERVE_UPSTREAM_IP=198.51.100.20

# Optional migration settings for an installation with existing clients.
# CUBIE_LEGACY_URL=https://old.example.com
# CUBIE_REDIRECT_HOSTS="alias.example.com"
# CUBIE_STORAGE_ID=https://old.example.com
# CUBIE_STORAGE_ALIASES="https://old.example.com https://alias.example.com"

# Optional. The deploy key is granted access only when you supply its public half.
# CUBIE_CI_PUBLIC_KEY_FILE=path/to/your-ci-deploy.pub

# Configure these when you package and publish signed Mac builds.
# CUBIE_MAC_TEAM_ID=YOURTEAMID
# CUBIE_SIGNING_IDENTITY=DEVELOPER_ID_APPLICATION_FINGERPRINT
# CUBIE_SPARKLE_PUBLIC_KEY=
