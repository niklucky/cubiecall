<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>Cubie</string>
	<key>CFBundleDisplayName</key>
	<string>Cubie</string>
	<key>CFBundleIdentifier</key>
	<string>com.quipcall.desktop</string>
	<key>CFBundleExecutable</key>
	<string>Cubie</string>
	<key>CFBundleIconFile</key>
	<string>@ICON@.icns</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>@VERSION@</string>
	<key>CFBundleVersion</key>
	<string>@BUILD@</string>
	<key>LSMinimumSystemVersion</key>
	<string>@MIN_MACOS@</string>
	<key>SUFeedURL</key>
	<string></string>
	<key>SUPublicEDKey</key>
	<string></string>
	<key>SUVerifyUpdateBeforeExtraction</key>
	<true/>
	<key>SURequireSignedFeed</key>
	<true/>
	<key>SUSignedFeedFailureExpirationInterval</key>
	<integer>0</integer>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUAutomaticallyUpdate</key>
	<true/>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.social-networking</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<!-- Stay on the integrated GPU on MacBooks with two. -->
	<key>NSSupportsAutomaticGraphicsSwitching</key>
	<true/>
	<key>NSMicrophoneUsageDescription</key>
	<string>Cubie uses the microphone so people in your calls can hear you.</string>
	<key>NSCameraUsageDescription</key>
	<string>Cubie uses the camera so people in your calls can see you.</string>
	<!-- Call links: cubie://join/<room> -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>Cubie call link</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>cubie</string>
				<string>quipcall</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
