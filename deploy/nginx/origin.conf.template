# @PRIMARY_HOST@: web client, API and LiveKit signalling behind TLS.
# Media doesn't pass through nginx: clients reach LiveKit directly on
# UDP 7882 (TCP 7881 when UDP is blocked).

map $http_upgrade $cubie_connection {
    default upgrade;
    ''      close;
}

# Retain the reserve marker for the previous API binary during an upgrade.
map $realip_remote_addr $cubie_forwarded_host {
@RESERVE_PEER_MAP@
    default       "";
}

# The old host's secure session cookie is only visible over HTTPS.
map $host $cubie_https_host {
    default @PRIMARY_HOST@;
@LEGACY_HTTP_MAP@
}

# Old email links used /#magic=... and have no request query or cookie.
map "$host:$cookie_qc_session:$request_uri" $cubie_check_fragment {
    default 0;
@LEGACY_FRAGMENT_MAP@
}

map "$host:$cookie_qc_session" $cubie_redirect_web {
    default 0;
@LEGACY_GUEST_MAP@
}

server {
    listen 80;
    listen [::]:80;
    server_name @CERTIFICATE_HOSTS@;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/cubie-acme;
        try_files $uri =404;
    }

    location / {
        return 308 https://$cubie_https_host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name @WWW_HOSTS@;

    ssl_certificate /etc/letsencrypt/live/@PRIMARY_HOST@/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/@PRIMARY_HOST@/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    return 308 https://$cubie_https_host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name @ORIGIN_HOSTS@;

    ssl_certificate /etc/letsencrypt/live/@PRIMARY_HOST@/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/@PRIMARY_HOST@/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    # Room links stay out of other sites' logs.
    add_header Referrer-Policy no-referrer always;

    root /opt/cubie/web;
    index index.html;

    location = /legacy-entry.html {
        internal;
        expires -1;
    }

    # Sign-in must set the cookie on the origin that issued the email.
    location = /signin {
@CANONICAL_REDIRECTS@
        try_files /index.html =404;
        expires -1;
    }

    # Only nginx may invoke the signaling authorization subrequest.
    location = /api/media/check { return 404; }
    location = /_cubie_media_auth {
        internal;
        proxy_pass http://127.0.0.1:4601/api/media/check;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header Authorization $http_authorization;
    }

    location /api/ {
@RESERVE_REAL_IP@
        proxy_pass http://127.0.0.1:4601;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $cubie_forwarded_host;
        proxy_set_header X-Real-IP $remote_addr;
        # The API identifies the edge by this immediate peer. X-Real-IP
        # above is the browser's address, restored only for the trusted edge.
        proxy_set_header X-Forwarded-For $realip_remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # LiveKit signalling (WebSocket). Lives as long as the call.
    location /rtc {
        # Also checks refreshed/replayed LiveKit tokens against room membership.
        auth_request /_cubie_media_auth;
        # Signaling URLs contain bearer tokens.
        access_log off;
        proxy_pass http://127.0.0.1:7880;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $cubie_connection;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        proxy_buffering off;
    }

    # The Mac app and its install script.
    location /download/ {
        alias /opt/cubie/download/;
        expires -1;
    }

    # Vite's hashed bundles never change.
    location /assets/ {
        expires 1y;
    }

    location / {
        # Native API and WebSocket requests use the locations above directly.
@CANONICAL_REDIRECTS@
        # Existing guests can only present their host-bound session here.
        # A temporary redirect avoids caching the cookie-dependent decision.
        if ($cubie_check_fragment) { rewrite ^ /legacy-entry.html last; }
        if ($cubie_redirect_web) {
            # nginx inherits none of the server headers once one is set here.
            add_header Strict-Transport-Security "max-age=31536000" always;
            add_header X-Content-Type-Options nosniff always;
            add_header Cache-Control "private, no-store" always;
            add_header Referrer-Policy no-referrer always;
            return 307 https://@PRIMARY_HOST@$request_uri;
        }
        try_files $uri /index.html;
        expires -1;
    }
}
