# First deploy only: serves the ACME challenge until a certificate exists,
# then deploy/install.sh swaps in @PRIMARY_HOST@.conf.
server {
    listen 80;
    listen [::]:80;
    server_name @ACME_HOSTS@;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/cubie-acme;
        try_files $uri =404;
    }

    location / {
        return 307 https://@PRIMARY_HOST@$request_uri;
    }
}
